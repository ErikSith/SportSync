{
  "name": "sportsync",
  "version": "1.0.0",
  "description": "SportSync - Next.js 14 + Prisma + Supabase Auth frontend, with a CrewAI-ready Express matchmaking API",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-dev-port.mjs && next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "dev:api": "tsx watch src/server.ts",
    "build:api": "tsc -p tsconfig.server.json",
    "start:api": "node dist/server.js",
    "typecheck:api": "tsc -p tsconfig.server.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "scrape": "tsx scripts/scrape-to-json.ts && tsx scripts/build-borough-ingest.ts && tsx scripts/build-jsonb-ingest.ts",
    "scrape:events": "tsx scripts/scrape-events.ts",
    "scrape:dedupe": "tsx scripts/cleanup-duplicate-events.ts",
    "scrape:json": "tsx scripts/scrape-to-json.ts",
    "scrape:build-sql": "tsx scripts/build-borough-ingest.ts && tsx scripts/build-jsonb-ingest.ts",
    "share:qr": "node scripts/generate-share-qr.mjs",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "dev:tunnel": "node scripts/require-dev-port.mjs && npx cloudflared tunnel --url http://localhost:3000",
    "dev:share": "powershell -ExecutionPolicy Bypass -File scripts/dev-with-tunnel.ps1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.10.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "next": "^14.2.18",
    "node-cron": "^3.0.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.10.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
