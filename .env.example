# --- Supabase (Next.js frontend + Auth) ---------------------------------
# Project settings -> API. Safe to expose to the browser (RLS protects data).
# Set these in Cloudflare Pages → Settings → Environment variables (Production
# AND Build). NEXT_PUBLIC_* are inlined at build time; also set SUPABASE_URL /
# SUPABASE_ANON_KEY as runtime fallbacks for Edge Workers.
NEXT_PUBLIC_SUPABASE_URL="https://jnxpmtaystxywjxxyexh.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImpueHBtdGF5c3R4eXdqeHh5ZXhoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODM5OTkxNDQsImV4cCI6MjA5OTU3NTE0NH0.S80JllFSdiex961xJHkZR8u7QxiPU6Uzl24MtVKfXuA"
# Optional runtime aliases (recommended on Cloudflare Pages):
# SUPABASE_URL="https://jnxpmtaystxywjxxyexh.supabase.co"
# SUPABASE_ANON_KEY="<same anon key>"

# Server-only. Bypasses RLS - Settings -> API -> service_role. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="fill-in-from-supabase-dashboard"

# --- Prisma (optional for Next.js frontend — only needed for `npm run seed` / migrations) --
# The Next.js app reads data via Supabase REST + RLS using the anon key above.
# When you do need Prisma CLI, use the Supabase *pooler* on port 6543:
# DATABASE_URL="postgresql://postgres.jnxpmtaystxywjxxyexh:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.jnxpmtaystxywjxxyexh.supabase.co:5432/postgres?schema=public"

# --- Legacy Express API (CrewAI matchmaking backend, src/) --------------
PORT=3000
AGENT_API_KEY="change-me-crewai-secret"
DEFAULT_RADIUS_KM=20
EXTENDED_RADIUS_KM=50

# --- AI (Next.js team event creation) -----------------------------------
# Optional. When set, /api/ai/events/parse uses OpenAI for natural-language event drafts.
# Without it, SportSync falls back to a built-in heuristic parser.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- Gemini Flash (free-tier Cheerio scraper: npm run scrape:gemini) -----
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional override (default: gemini-3.5-flash). Do not use gemini-flash-latest
# — it aliases gemini-3.7-flash (~20 RPD on Free Tier).
# GEMINI_MODEL="gemini-3.5-flash"
# SCRAPER_DRY_RUN="true"
# SCRAPER_LIMIT="5"

# --- Google Places (venue discovery → GPS + website URLs) ----------------
# Enable Places API (New) in Google Cloud; server-only key (never NEXT_PUBLIC_).
GOOGLE_PLACES_API_KEY=""
# Alias also accepted: GOOGLE_MAPS_API_KEY=""
# npm run discover:venues -- --dry-run --queries 2 --limit 5
# Flags: --discover-only | --scrape-only | --dry-run | --queries N | --limit N

# Early access: login/registration skipped by default (omit or "true").
# Set to "false" when email auth ships and you want to require accounts.
AUTH_BYPASS="true"
# Keep in sync with AUTH_BYPASS — client silent guest auth (lobby/crew on phones) reads this.
NEXT_PUBLIC_AUTH_BYPASS="true"

# Public URL for QR codes / beta invites (Vercel / Cloudflare domain). No trailing slash.
NEXT_PUBLIC_APP_URL="https://sportsync-ct5.pages.dev"
