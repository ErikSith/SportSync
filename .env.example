# Server-only. Bypasses RLS - Settings -> API -> service_role. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="fill-in-from-supabase-dashboard"

# --- Prisma (optional for Next.js frontend — only needed for `npm run seed` / migrations) --
# The Next.js app reads data via Supabase REST + RLS using the anon key above.
# When you do need Prisma CLI, use the Supabase *pooler* on port 6543:
# DATABASE_URL="postgresql://postgres.jnxpmtaystxywjxxyexh:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.jnxpmtaystxywjxxyexh.supabase.co:5432/postgres?schema=public"

# --- Legacy Express API (CrewAI matchmaking backend, src/) --------------
PORT=3000
AGENT_API_KEY="change-me-crewai-secret"
DEFAULT_RADIUS_KM=20
EXTENDED_RADIUS_KM=50

# --- AI (Next.js team event creation) -----------------------------------
# Optional. When set, /api/ai/events/parse uses OpenAI for natural-language event drafts.
# Without it, SportSync falls back to a built-in heuristic parser.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Early access: login/registration skipped by default (omit or "true").
# Set to "false" when email auth ships and you want to require accounts.
AUTH_BYPASS="true"

# Public URL for QR codes / beta invites (Vercel domain or localtunnel). No trailing slash.
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
